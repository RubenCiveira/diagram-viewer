        "additionalProperties": false
      },
      "description": "Diagramas que aparecen en el árbol inicial."
    },
    "$schema": {
      "type": "string",
      "description": "Ruta a este schema (opcional)."
    }
  },
  "required": [
    "diagrams"
  ],
  "description": "Índice de diagramas de la carpeta raíz: solo nombres y rutas.",
