{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "index.schema.json",
  "title": "Índice de diagramas del visor",
  "type": "object",
  "properties": {
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Carpeta del diagrama (se abre su index.json) o fichero .json, relativa a la raíz."
          },
          "name": {
            "description": "Nombre visible.",
            "type": "string"
          },
