{
  "version": "1.0",
  "title": "Desnivel hacia los nodos finales",
  "description": "Dos casos de uso llaman a tres gateways; el primero tiene **7** dependencias finales y los otros dos, **2** cada uno. Con el layout por baricentro los tres gateways quedan apiñados y las 7 APIs del primero se desparraman. Cambia el algoritmo con el selector **Layout** de abajo.",
  "nodes": [
    {
      "id": "list",
      "kind": "node",
      "type": "useCase",
      "name": "List notification",
      "props": {
        "trigger": "REST",
        "endpoint": "GET /notifications"
      }
    },
    {
      "id": "delete",
      "kind": "node",
      "type": "useCase",
      "name": "Delete notification",
      "props": {
        "trigger": "REST",
        "endpoint": "DELETE /notifications/{id}"
      }
    },
    {
      "id": "retrieve",
      "kind": "node",
      "type": "serviceGateway",
      "name": "Retrieve notifications",
      "props": {
        "port": "Notifications"
      }
    },
    {
      "id": "user",
      "kind": "node",
      "type": "serviceGateway",
      "name": "Get user data",
      "props": {
        "port": "UserData"
      }
    },
    {
      "id": "retrieve-2",
      "kind": "node",
      "type": "serviceGateway",
      "name": "Retrieve notifications",
      "props": {
        "port": "NotificationsLegacy"
      }
    },
    {
      "id": "api-1",
      "kind": "node",
      "type": "api",
      "name": "Card contracts consultivo",
      "props": {
        "protocol": "https"
      }
    },
    {
      "id": "api-2",
      "kind": "node",
      "type": "api",
      "name": "Statements status consultivo",
      "props": {
        "protocol": "https"
      }
    },
    {
