      "props": {
        "protocol": "https"
      }
    },
    {
      "id": "api-4",
      "kind": "node",
      "type": "api",
      "name": "CMC Sign consultivo",
      "props": {
        "protocol": "https"
      }
    },
    {
      "id": "api-5",
      "kind": "node",
      "type": "api",
      "name": "PFM Aggregations consultivo",
      "props": {
        "protocol": "https"
      }
    },
    {
      "id": "api-6",
      "kind": "node",
      "type": "api",
      "name": "PFM Budget consultivo",
      "props": {
        "protocol": "https"
      }
    },
    {
      "id": "api-7",
      "kind": "node",
      "type": "api",
      "name": "Accounts new movements consultivo",
      "props": {
        "protocol": "https"
      }
