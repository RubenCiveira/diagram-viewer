      "kind": "node",
      "type": "useCase",
      "name": "Crear pedido"
    },
    {
      "id": "a-uc2",
      "kind": "node",
      "type": "useCase",
      "name": "Consultar pedido"
    },
    {
      "id": "a-uc3",
