{
  "version": "1.0",
  "title": "Desnivel en capas intermedias",
  "description": "Tres servicios con **6**, **1** y **2** casos de uso. El desnivel aparece ya en la capa intermedia (casos de uso) y se repite en la final: el único caso de uso de *Facturación* tiene **5** dependencias. Cambia el algoritmo con el selector **Layout** de abajo.",
  "nodes": [
    {
      "id": "usuario",
      "kind": "node",
      "type": "actor-user",
      "name": "Usuario",
      "props": {
        "category": "Cliente"
      }
    },
    {
      "id": "gateway",
      "kind": "node",
      "type": "gateway",
      "name": "API Gateway",
      "props": {
        "entryHost": "api.example.com"
      }
    },
    {
      "id": "svc-a",
      "kind": "node",
      "type": "microservice",
      "name": "Pedidos",
      "props": {
        "tech": "spring"
      }
    },
    {
      "id": "svc-b",
      "kind": "node",
      "type": "microservice",
      "name": "Facturación",
      "props": {
        "tech": "quarkus"
      }
    },
    {
      "id": "svc-c",
      "kind": "node",
