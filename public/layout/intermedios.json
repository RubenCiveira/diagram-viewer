      "type": "useCase",
      "name": "Cancelar pedido"
    },
    {
      "id": "a-uc5",
      "kind": "node",
      "type": "useCase",
      "name": "Modificar dirección"
    },
    {
      "id": "a-uc6",
      "kind": "node",
      "type": "useCase",
      "name": "Repetir pedido"
    },
    {
      "id": "a-repo",
      "kind": "node",
